---
import site from '../data/site.json';

const year = new Date().getFullYear();
const links = [
  site.email && { label: 'Email', href: `mailto:${site.email}` },
  site.social?.github && { label: 'GitHub', href: `https://github.com/${site.social.github}` },
  site.social?.twitter && { label: 'X / Twitter', href: `https://x.com/${site.social.twitter}` }
].filter(Boolean);
---

<footer class="border-t border-slate-200/80 py-8 dark:border-slate-800">
  <div class="container flex flex-col items-center gap-3 text-sm text-slate-500 dark:text-slate-400 md:flex-row md:justify-between">
    <p>&copy; {year} {site.author}</p>
    <nav class="flex items-center gap-4">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="transition-colors hover:text-indigo-600 dark:hover:text-indigo-400"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
