---
import Layout from '../components/Layout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import site from '../data/site.json';
import publications from '../data/publications.json';

const conference = publications.filter((p) => p.type === 'conference');
const preprint = publications.filter((p) => p.type === 'preprint');
const journal = publications.filter((p) => p.type === 'journal');

const years = [...new Set(conference.map((p) => p.year))].sort((a, b) => b - a);

// Preprints first, then conference papers by year (most recent on top),
// then a Journal section at the end. The left nav mirrors this same order.
const sections = [];

if (preprint.length > 0) {
  sections.push({ key: 'preprint', label: 'Preprints', pubs: preprint });
}

sections.push(
  ...years.map((year) => ({
    key: String(year),
    label: String(year),
    pubs: conference.filter((p) => p.year === year)
  }))
);

if (journal.length > 0) {
  sections.push({ key: 'journal', label: 'Journal', pubs: journal });
}
---

<Layout title="Publications" description="List of publications and preprints." image="/og-publications.svg">
  <h1 class="mb-1 font-serif text-3xl font-bold text-slate-900 dark:text-white">Publications</h1>
  <p class="mb-6 text-sm text-slate-500 dark:text-slate-400">
    {publications.length} publication{publications.length === 1 ? '' : 's'} &middot; {site.author} is bolded below
    &middot; * indicates equal contribution.
  </p>

  <div class="flex items-start gap-8">
    <nav aria-label="Jump to section" class="sticky top-24 hidden h-fit shrink-0 md:block">
      <ul class="relative border-l-2 border-slate-200 pl-4 dark:border-slate-700">
        {sections.map((s) => (
          <li class="relative py-1.5">
            <span
              data-year-dot={s.key}
              class="absolute -left-[21px] top-2 h-2 w-2 rounded-full bg-slate-300 transition-colors dark:bg-slate-600"
            />
            <a
              href={`#y-${s.key}`}
              data-year-link={s.key}
              class="year-nav-link text-sm text-slate-500 transition-colors hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="min-w-0 flex-1">
      {sections.map((s, i) => (
        <section id={`y-${s.key}`} class:list={['scroll-mt-24', i > 0 && 'mt-8 border-t border-slate-200 pt-8 dark:border-slate-800']}>
          <h2 class="mb-3 font-serif text-lg font-semibold text-slate-900 dark:text-white">{s.label}</h2>
          <div class="space-y-3">
            {s.pubs.map((pub) => <PublicationCard pub={pub} />)}
          </div>
        </section>
      ))}
    </div>
  </div>

  <script>
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-year-link]');
    const dots = document.querySelectorAll<HTMLElement>('[data-year-dot]');
    const sections = document.querySelectorAll<HTMLElement>('section[id^="y-"]');

    const setActive = (key: string) => {
      links.forEach((el) => {
        const active = el.dataset.yearLink === key;
        el.classList.toggle('text-indigo-600', active);
        el.classList.toggle('dark:text-indigo-400', active);
        el.classList.toggle('font-medium', active);
      });
      dots.forEach((el) => {
        el.classList.toggle('bg-indigo-500', el.dataset.yearDot === key);
        el.classList.toggle('dark:bg-indigo-500', el.dataset.yearDot === key);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id.replace('y-', ''));
        }
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    sections.forEach((section) => observer.observe(section));
  </script>
</Layout>
