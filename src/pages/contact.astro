---
import Layout from '../components/Layout.astro';
import site from '../data/site.json';

// Add a new platform by adding an entry here — the Contact page will pick up
// any key in site.social (src/data/site.json) that has a non-empty value.
const SOCIAL_META = {
  github: { label: 'GitHub', href: (v) => `https://github.com/${v}`, handle: (v) => `@${v}` },
  twitter: { label: 'X / Twitter', href: (v) => `https://x.com/${v}`, handle: (v) => `@${v}` },
  linkedin: { label: 'LinkedIn', href: (v) => v },
  googleScholar: { label: 'Google Scholar', href: (v) => v }
};

const socialLinks = Object.entries(site.social || {})
  .filter(([, value]) => value)
  .map(([key, value]) => {
    const meta = SOCIAL_META[key] ?? { label: key, href: (v) => v };
    return { label: meta.label, value: meta.handle?.(value), href: meta.href(value) };
  });

const links = [
  site.email && { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  ...socialLinks
].filter(Boolean);
---

<Layout title="Contact" description="Get in touch by email or find me elsewhere online." image="/og-contact.svg">
  <h1 class="mb-2 font-serif text-3xl font-bold text-slate-900 dark:text-white">Get in Touch</h1>
  <p class="mb-6 text-slate-700 dark:text-slate-300">
    The fastest way to reach me is by email. You can also find me on the platforms below.
  </p>

  <div class="grid max-w-lg gap-3">
    {links.map((link) => (
      <a
        href={link.href}
        target={link.href.startsWith('http') ? '_blank' : undefined}
        rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="card flex items-center justify-between px-4 py-3 transition-colors hover:border-indigo-300 dark:hover:border-indigo-700"
      >
        <span class="font-medium text-slate-900 dark:text-white">{link.label}</span>
        {link.value && <span class="text-sm text-slate-500 dark:text-slate-400">{link.value}</span>}
      </a>
    ))}
  </div>
</Layout>
