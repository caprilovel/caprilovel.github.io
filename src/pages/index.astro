---
import Layout from '../components/Layout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import AdvisorList from '../components/AdvisorList.astro';
import site from '../data/site.json';
import publications from '../data/publications.json';

const recent = publications.slice(0, 3);
---

<Layout title="Home" description={site.description} image="/og-home.svg">
  <section class="hero-bg -mx-4 mb-10 rounded-2xl px-6 py-10 md:px-10">
    <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
      <div class="flex flex-col items-center gap-3">
        <img src={site.avatar} alt={site.author} class="profile-avatar" />
        <SocialLinks />
      </div>
      <div>
        <h1 class="font-serif text-3xl font-bold leading-tight text-slate-900 dark:text-white md:text-4xl">
          {site.author}
        </h1>
        <AdvisorList advisors={site.advisors} class="mt-2" />
        {site.bio && <p class="mt-3 max-w-2xl text-slate-700 dark:text-slate-300">{site.bio}</p>}

        <div class="mt-5 flex flex-wrap justify-center gap-3 md:justify-start">
          <a href="/cv.pdf" class="inline-block rounded-md bg-indigo-600 px-4 py-2 font-medium text-white transition-colors hover:bg-indigo-700">
            Download CV
          </a>
          <a href="/publications" class="inline-block rounded-md border border-slate-300 px-4 py-2 text-slate-700 transition-colors hover:border-slate-400 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-600">
            Publications
          </a>
        </div>

        {site.researchInterests?.length > 0 && (
          <div class="mt-5 flex flex-wrap justify-center gap-2 md:justify-start">
            {site.researchInterests.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
    <div class="md:col-span-2">
      <h2 class="mb-3 font-serif text-2xl font-semibold text-slate-900 dark:text-white">Selected Publications</h2>
      <div class="space-y-3">
        {recent.map((pub) => <PublicationCard pub={pub} />)}
      </div>
      <p class="mt-4">
        <a class="text-indigo-600 hover:underline dark:text-indigo-400" href="/publications">See all publications &rarr;</a>
      </p>
    </div>

    <aside>
      {site.news?.length > 0 && (
        <div class="card p-5">
          <h2 class="mb-2 font-serif text-xl font-semibold text-slate-900 dark:text-white">News</h2>
          <ul class="timeline">
            {site.news.map((item) => (
              <li>
                <span class="timeline-date">{item.date}</span>
                <span class="text-slate-700 dark:text-slate-300">{item.text}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Layout>
